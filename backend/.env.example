ENVIRONMENT=development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-sb-secret-key
APP_SESSION_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGINS=http://localhost:3000
# Optional. Prefer an exact FRONTEND_ORIGINS value in production. Use this only
# if you intentionally allow your own Vercel preview deployment hostnames.
FRONTEND_ORIGIN_REGEX=
AUTH_REQUESTS_PER_MINUTE=20

# Multimodal catalogue provider: ollama or openai
AI_PROVIDER=ollama
AI_TIMEOUT_SECONDS=45
AI_REQUEST_DEADLINE_SECONDS=70
AI_REQUESTS_PER_MINUTE=5
AI_REQUESTS_PER_HOUR=30
AI_MAX_ACCOUNT_CONCURRENCY=1
AI_MAX_GLOBAL_CONCURRENCY=4
AI_CACHE_TTL_SECONDS=300
AI_CACHE_MAX_ENTRIES=128
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_SECONDS=60
AI_MAX_RESPONSE_BYTES=524288
# Vercel Functions enforce a 4.5 MB request/response body limit. These leave
# room for multipart form metadata while accepting a product image + voice note.
AI_MAX_REQUEST_BYTES=4250000
AI_MAX_IMAGE_BYTES=3000000
AI_MAX_AUDIO_BYTES=750000
UPLOAD_MAX_IMAGE_BYTES=4000000
UPLOAD_MAX_AUDIO_BYTES=4000000

# Ollama Cloud (the base URL can also point to a local Ollama server)
OLLAMA_API_KEY=replace-with-ollama-key
OLLAMA_MODEL=gemma3:27b
OLLAMA_BASE_URL=https://ollama.com/api

# Optional alternate catalogue provider
OPENAI_API_KEY=replace-with-openai-key
OPENAI_MODEL=gpt-4.1-mini

# Required for regional-language voice transcription and translation
SARVAM_API_KEY=replace-with-sarvam-key
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v3
